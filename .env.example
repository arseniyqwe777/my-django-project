echo "# Database settings" > .env.example
echo "DB_NAME=bookbridge" >> .env.example
echo "DB_USER=postgres" >> .env.example
echo "DB_PASSWORD=your_password_here" >> .env.example
echo "DB_HOST=localhost" >> .env.example
echo "DB_PORT=5432" >> .env.example
echo "" >> .env.example
echo "# Redis settings" >> .env.example
echo "REDIS_URL=redis://localhost:6379/1" >> .env.example