# Скопируй этот файл в .env и заполни реальными значениями.
# .env НЕ должен попадать в git — проверь, что он есть в .gitignore.

# Сгенерируй новый ключ, например:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-new-random-key

DEBUG=False

# Через запятую, без пробелов
ALLOWED_HOSTS=127.0.0.1,localhost,arseniyqwe777-my-django-project-d6f4.twc1.net

DB_NAME=nn
DB_USER=postgres
DB_PASSWORD=change-me-rotate-this-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Включай только когда точно настроен SSL-сертификат на домене
SECURE_SSL_REDIRECT=False
